--     @<id_parameter> = <safe_example_id>;

-- PURPOSE:
-- <Describe the business deletion and caller-visible outcome>
*/

-- Team template assumes a GO-aware SQL deployment tool; confirm the selected mode.
CREATE PROC [<schema_name>].[delete_<module>_v<version>]
(
    @<id_parameter> <SQL_ID_DATA_TYPE>
)
AS
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    BEGIN TRY
        BEGIN TRAN;

        IF NOT EXISTS
        (
            SELECT  1
            FROM    [<schema_name>].[<table_name>]
            WHERE   <id_column> = @<id_parameter>
        )
        BEGIN
            RAISERROR(N'<Business validation: record not found>', 16, 1);
        END;

        DELETE  FROM [<schema_name>].[<table_name>]
        WHERE   <id_column> = @<id_parameter>;

        COMMIT TRAN;
    END TRY
    BEGIN CATCH
        IF XACT_STATE() <> 0
            ROLLBACK TRAN;

        THROW;
    END CATCH;
END;
GO
